@echo off
setlocal
powershell.exe -NoLogo -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; try { $candidates=@(); if($env:TOOLVISUALS_DIAGNOSTIC_CONFIG){$roots=@($env:TOOLVISUALS_DIAGNOSTIC_CONFIG)}else{$profileRoot=Join-Path $env:LOCALAPPDATA 'ToolLauncher\profiles'; $roots=@(Get-ChildItem -LiteralPath $profileRoot -Directory -ErrorAction SilentlyContinue | ForEach-Object {Join-Path $_.FullName 'config'}); $roots+=Join-Path $env:APPDATA '.minecraft\config'}; foreach($configDir in $roots){$configFile=Get-Item -LiteralPath (Join-Path $configDir 'toolvisuals.json') -ErrorAction SilentlyContinue; if($configFile -and -not $configFile.PSIsContainer){$gameLog=Get-Item -LiteralPath (Join-Path (Split-Path $configDir -Parent) 'logs\latest.log') -ErrorAction SilentlyContinue; $stamp=if($gameLog){$gameLog.LastWriteTimeUtc}else{$configFile.LastWriteTimeUtc}; $candidates+=[pscustomobject]@{Config=$configDir; Stamp=$stamp}}}; $selected=$candidates | Sort-Object Stamp -Descending | Select-Object -First 1; if(-not $selected){throw 'ToolVisuals configuration not found. Set TOOLVISUALS_DIAGNOSTIC_CONFIG to its config directory.'}; $marker=Join-Path $selected.Config 'tooldiagnostic.txt'; $existing=Get-Item -LiteralPath $marker -ErrorAction SilentlyContinue; if($existing -and ($existing.PSIsContainer -or ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint))){throw 'The diagnostic marker must be a regular file.'}; $stream=[IO.File]::Open($marker,[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::Write,[IO.FileShare]::ReadWrite); $stream.Dispose(); Write-Host 'ToolVisuals performance diagnostics enabled.'; Write-Host ('Selected latest-used configuration: '+$selected.Config); Write-Host ('Report: '+$marker); Write-Host 'Return to the game and reproduce the stutters. No restart is needed.'; exit 0 } catch { Write-Error $_.Exception.Message; exit 1 }"
set "toolDiagnosticExit=%errorlevel%"
if /i not "%~1"=="--no-pause" pause
exit /b %toolDiagnosticExit%
