<Window x:Class="ToolLauncher.Presentation.GarbageCollection.GarbageCollectorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" SizeToContent="Height" MaxHeight="600" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F5F3FA" FontFamily="Segoe UI" FontSize="16" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" Icon="/ToolLauncher;component/Assets/ToolVisuals.Executable.ico">
  <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="26,24">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock Text="{DynamicResource Text.gcTitle}" Foreground="{StaticResource Muted}" FontSize="14" />
        <TextBlock x:Name="CollectorTitle" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,5" />
        <TextBlock x:Name="ProfileText" Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
        <StackPanel>
          <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="24" />
          <Border Background="{StaticResource InputFill}" CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
            <TextBlock x:Name="CompatibilityText" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{StaticResource Muted}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,20,0,0">
        <TextBlock Text="{DynamicResource Text.gcApplyHint}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />
        <Button x:Name="ConfirmButton" Content="{DynamicResource Text.gcConfirm}" Style="{StaticResource Primary}" Click="ConfirmClick" IsEnabled="False" MinHeight="44" />
        <Button x:Name="CancelChoiceButton" Content="{DynamicResource Text.cancel}" Style="{StaticResource Quiet}" IsCancel="True" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
