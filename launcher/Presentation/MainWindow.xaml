            </Grid></ScrollViewer>
            <Grid x:Name="ModsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Text.mods}" FontSize="27" FontWeight="SemiBold" /><TextBlock x:Name="ModsSubtitle" Text="{DynamicResource Text.sourceHint}" Style="{StaticResource Hint}" /></StackPanel><Grid Grid.Row="1" Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="145" /><ColumnDefinition Width="14" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions><ComboBox x:Name="SourcePicker" SelectionChanged="SourceChanged" /><Grid Grid.Column="2"><TextBox x:Name="SearchInput" KeyDown="SearchKey" /><TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource Text.search}" Foreground="#797E96" Margin="13,10" IsHitTestVisible="False" /></Grid><Button Grid.Column="4" Content="{DynamicResource Text.searchButton}" Click="SearchClick" Style="{StaticResource Primary}" /></Grid>
              <Grid Grid.Row="2"><ListBox x:Name="CatalogList" ItemContainerStyle="{StaticResource ListItem}"><ListBox.ItemTemplate><DataTemplate><Border Background="#1B1E29" CornerRadius="11" Padding="19,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" Foreground="#A4A8BB" FontSize="12" TextWrapping="Wrap" MaxHeight="38" LineHeight="19" Margin="0,7,0,8" /><TextBlock Foreground="#8C85A2" FontSize="11"><Run Text="{Binding Author}" /><Run Text="  ·  " /><Run Text="{Binding Source}" /></TextBlock></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{DynamicResource Text.install}" Style="{StaticResource Primary}" Click="InstallClick" Padding="12,8" /><Button Content="{DynamicResource Text.website}" Style="{StaticResource Quiet}" Click="ModWebsiteClick" FontSize="11" Padding="7,6" Margin="0,4,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="CatalogEmpty" Text="{DynamicResource Text.selectFirst}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9295AA" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" /></Grid>
