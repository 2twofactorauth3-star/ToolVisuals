                          <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="Fabric" Foreground="#BEA9F4" FontSize="14" />
                            <TextBlock Text=" · " Foreground="#706C85" FontSize="14" />
                            <TextBlock Text="{Binding Java, StringFormat='Java {0}'}" Foreground="#B2B0C4" FontSize="14" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
