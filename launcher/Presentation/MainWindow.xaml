<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:accounts="clr-namespace:ToolLauncher.Presentation.Accounts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolLauncher.Presentation.MainWindow" Title="ToolLauncher" Icon="/ToolLauncher;component/Assets/ToolVisuals.ico" Width="1320" Height="860" MinWidth="1100" MinHeight="740" Background="#101215" Foreground="#F1F0EC" FontFamily="Segoe UI" FontSize="16" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" TextOptions.TextHintingMode="Fixed" SizeChanged="WindowSizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="RootVisual" BorderBrush="#2A2D34" BorderThickness="1" CornerRadius="14" Background="#101215" RenderOptions.ClearTypeHint="Enabled">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="102" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="HeaderDrag" Background="#141619">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="218" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Image Source="{StaticResource BrandLogo}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Clip>
              <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
            </Image.Clip>
          </Image>
          <TextBlock Text="ToolLauncher" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
          <TextBlock Text="MINECRAFT" Foreground="#777D87" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="/" Foreground="#434750" Margin="14,0" VerticalAlignment="Center" />
          <TextBlock x:Name="CurrentPageTitle" Text="{DynamicResource Text.home}" Foreground="#D1D2D7" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="LanguageButton" Content="EN" Click="LanguageClick" Style="{StaticResource Quiet}" FontSize="14" Padding="12,8" Margin="0,0,18,0" />
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="MinimizeClick">
            <Path Data="M 0,5 L 11,5" Style="{StaticResource LineIcon}" />
          </Button>
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="MaximizeClick">
            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Style="{StaticResource LineIcon}" />
          </Button>
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="CloseClick">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Style="{StaticResource LineIcon}" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="218" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#141619" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="16,26,16,0">
            <Button x:Name="HomeNav" Click="NavigationClick" Tag="home" Style="{StaticResource Navigation}" Background="{StaticResource NavSelected}" Foreground="#F4EFFF">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,9 L 10,1 L 19,9 M 4,7 L 4,19 L 16,19 L 16,7 M 8,19 L 8,13 L 12,13 L 12,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.home}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModsNav" Click="NavigationClick" Tag="mods" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,4 L 10,0 L 19,4 L 19,15 L 10,20 L 1,15 Z M 1,4 L 10,9 L 19,4 M 10,9 L 10,20" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.mods}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="InstalledNav" Click="NavigationClick" Tag="installed" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 12,1 L 19,1 L 19,8 L 12,8 Z M 1,12 L 8,12 L 8,19 L 1,19 Z M 12,12 L 19,12 L 19,19 L 12,19 Z" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.installed}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNav" Click="NavigationClick" Tag="settings" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 0,5 L 20,5 M 0,15 L 20,15 M 7,1 L 7,9 M 14,11 L 14,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.settings}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="18,0,18,20">
            <Button Content="{DynamicResource Text.community}" Click="CommunityClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" />
            <Button Content="{DynamicResource Text.source}" Click="SourceClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" Margin="0,0,0,12" />
            <Border Background="#1D1F25" CornerRadius="10" Padding="13">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" Background="#30283E" CornerRadius="10">
                    <Path Data="M 6,5 A 4,4 0 1 1 14,5 A 4,4 0 1 1 6,5 M 1,20 C 1,10 19,10 19,20" Style="{StaticResource LineIcon}" Width="18" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#C4ACEF" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountName" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountKind" Foreground="#A5A1B8" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <Button Content="{DynamicResource Text.chooseAccount}" Click="AccountSettingsClick" Background="#2B2D36" Padding="8,8" FontSize="14" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="26,22,24,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="PageHost" Background="#101215">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,7,0">
                <Border x:Name="HeroSurface" Height="340" CornerRadius="14" MouseMove="HeroMouseMove" MouseEnter="HeroMouseEnter" MouseLeave="HeroMouseLeave">
                  <Border.Background>
                    <ImageBrush ImageSource="{StaticResource Landscape}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                  </Border.Background>
                  <Grid>
                    <Border CornerRadius="14">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#E50C1217" Offset="0" />
                          <GradientStop Color="#A30D1419" Offset="0.37" />
                          <GradientStop Color="#280C1217" Offset="0.73" />
                          <GradientStop Color="#110C1217" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border CornerRadius="14">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#00101419" Offset="0.42" />
                          <GradientStop Color="#C9101419" Offset="1" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                    <Border x:Name="HeroPointerLight" CornerRadius="14" IsHitTestVisible="False" Opacity="0">
                      <Border.Background>
                        <RadialGradientBrush x:Name="HeroLightBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.4" RadiusY="0.85">
                          <GradientStop Color="#1CC8B7F6" Offset="0" />
                          <GradientStop Color="#00C8B7F6" Offset="1" />
                        </RadialGradientBrush>
                      </Border.Background>
                    </Border>
                    <Grid Margin="32,25,30,24">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#D3C4FF" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeroBuildLabel" Text="TOOLVISUALS" FontSize="14" Foreground="#DDD7EB" FontWeight="SemiBold" />
                        <TextBlock Text="/ JAVA EDITION" FontSize="14" Foreground="#A7AAA9" Margin="10,0,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Left" Margin="0,12,0,12">
                        <TextBlock x:Name="HeroTitleText" Text="Minecraft" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="46" LineHeight="52" LineStackingStrategy="BlockLineHeight" Foreground="#F7F5EF" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
                <Grid Margin="0,23,0,12">
                  <TextBlock Text="{DynamicResource Text.choose}" FontSize="21" FontWeight="SemiBold" />
                  <Button Content="{DynamicResource Text.clearVersion}" Click="ClearVersionClick" Style="{StaticResource Quiet}" FontSize="14" Padding="4,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ListBox x:Name="VersionList" SelectionChanged="VersionChanged" ItemContainerStyle="{StaticResource VersionItem}" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="60">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Minecraft}" FontFamily="Segoe UI" FontSize="27" FontWeight="SemiBold" Foreground="#ECEAEF" />
                        <Border Width="18" Height="18" CornerRadius="9" BorderBrush="#51515E" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                  <Setter Property="Background" Value="#C6B6F5" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Path Data="M 0,4 L 3,7 L 9,0" Width="9" Height="7" Stroke="#211B30" StrokeThickness="1.8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.Style>
                              <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Path.Style>
                          </Path>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                          <TextBlock Text="Fabric" Foreground="#B8ADD0" FontSize="14" />
                          <TextBlock Text="  /  " Foreground="#616571" FontSize="14" />
                          <TextBlock Text="{Binding Java, StringFormat='Java {0}'}" Foreground="#969AA5" FontSize="14" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ModsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Text.mods}" FontSize="29" FontWeight="SemiBold" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="SearchInput" KeyDown="SearchKey" />
                  <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource Text.search}" Foreground="#797E96" Margin="13,10" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="2" Content="{DynamicResource Text.searchButton}" Click="SearchClick" Style="{StaticResource Primary}" />
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="CatalogList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#171A1F" CornerRadius="0" Padding="17,19" BorderBrush="#2B2F36" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="142" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" Foreground="#A4A8BB" FontSize="15" TextWrapping="Wrap" MaxHeight="48" LineHeight="23" Margin="0,7,0,8" />
                            <TextBlock Foreground="#8C85A2" FontSize="14">
                              <Run Text="{Binding Author, Mode=OneWay}" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding Source, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Text.install}" Style="{StaticResource Primary}" Click="InstallClick" Padding="12,8" />
                            <Button Content="{DynamicResource Text.website}" Style="{StaticResource Quiet}" Click="ModWebsiteClick" FontSize="14" Padding="7,6" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CatalogEmpty" Text="{DynamicResource Text.selectFirst}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9295AA" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
              </Grid>
              <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Quiet}" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="{DynamicResource Text.previous}" Click="PreviousClick" Style="{StaticResource Quiet}" />
                  <TextBlock x:Name="PageNumber" Text="1" VerticalAlignment="Center" Margin="10,0" Foreground="#969BAF" />
                  <Button x:Name="NextCatalogPage" Content="{DynamicResource Text.next}" Click="NextClick" Style="{StaticResource Quiet}" />
                </StackPanel>
              </DockPanel>
            </Grid>
            <Grid x:Name="InstalledPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Text.installed}" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Text.installedHint}" Style="{StaticResource Hint}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ListBox x:Name="InstalledList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#171A1F" CornerRadius="0" Padding="17,19" BorderBrush="#2B2F36" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="244" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Version}" Foreground="#A3A6BC" FontSize="15" Margin="0,6,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="ToggleModClick" Margin="0,0,7,0" Padding="15,8">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                  <Setter Property="Content" Value="{DynamicResource Text.enable}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                      <Setter Property="Content" Value="{DynamicResource Text.disable}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Id}" Value="toolvisuals">
                                      <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Text.remove}" Click="RemoveModClick" Style="{StaticResource Quiet}" Padding="10,8" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="InstalledEmpty" Text="{DynamicResource Text.emptyInstalled}" Foreground="#9295AA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Primary}" />
                <Button Content="{DynamicResource Text.openProfile}" Click="ProfileFolderClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button Content="{DynamicResource Text.refresh}" Click="RefreshModsClick" Style="{StaticResource Quiet}" />
              </StackPanel>
            </Grid>
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Text.settings}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,20" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,14,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Text.account}" FontWeight="SemiBold" FontSize="19" Margin="0,0,0,17" />
                    <TextBlock Text="{DynamicResource Text.savedAccounts}" Style="{StaticResource Caption}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="AccountPicker" DisplayMemberPath="Label" SelectionChanged="AccountSelected" />
                      <Button Grid.Column="2" Content="×" Click="RemoveAccountClick" ToolTip="{DynamicResource Text.removeAccount}" Padding="12,8" />
                    </Grid>
                    <TextBlock x:Name="AccountSelectionHint" Style="{StaticResource Hint}" FontSize="14" />
                    <Button Content="{DynamicResource Text.importAccounts}" Click="AccountImportClick" Margin="0,0,0,18" />
                    <TextBlock Text="{DynamicResource Text.nickname}" Style="{StaticResource Caption}" />
                    <TextBox x:Name="NicknameInput" MaxLength="16" />
                    <TextBlock Text="{DynamicResource Text.nicknameHint}" Style="{StaticResource Hint}" />
                    <Button Content="{DynamicResource Text.signIn}" Click="SignInClick" />
                    <Button Content="{DynamicResource Text.signOut}" Click="SignOutClick" Style="{StaticResource Quiet}" Margin="0,6,0,20" />
                    <TextBlock Text="{DynamicResource Text.msClientId}" Style="{StaticResource Caption}" />
                    <TextBox x:Name="MicrosoftIdInput" MaxLength="36" FontSize="14" />
                    <TextBlock Text="{DynamicResource Text.msHint}" Style="{StaticResource Hint}" />
                    <TextBlock Text="{DynamicResource Text.cfKey}" Style="{StaticResource Caption}" Margin="0,15,0,7" />
                    <PasswordBox x:Name="CurseKeyInput" />
                    <TextBlock Text="{DynamicResource Text.cfHint}" Style="{StaticResource Hint}" />
                    <Button Content="CurseForge API ↗" Click="CurseConsoleClick" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,4" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,13">
                      <TextBlock Text="{DynamicResource Text.memory}" FontWeight="SemiBold" FontSize="19" />
                      <TextBlock x:Name="MemoryLabel" HorizontalAlignment="Right" Foreground="#BBA9F4" VerticalAlignment="Center" />
                    </Grid>
                    <Slider x:Name="MemorySlider" Minimum="1024" Maximum="1024" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" Margin="0,7,0,8" />
                    <TextBlock x:Name="MemoryBudgetHint" Style="{StaticResource Hint}" Margin="0,0,0,20" />
                    <TextBlock Text="{DynamicResource Text.java}" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,10" />
                    <CheckBox x:Name="AutoJavaCheck" Content="{DynamicResource Text.autoJava}" />
                    <TextBlock Text="Java 21" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="Java21Input" FontSize="14" />
                      <Button Grid.Column="1" Content="…" Tag="21" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" />
                    </Grid>
                    <TextBlock Text="Java 25" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="Java25Input" FontSize="14" />
                      <Button Grid.Column="1" Content="…" Tag="25" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" />
                    </Grid>
                    <TextBlock Text="{DynamicResource Text.javaHint}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" />
                <Button Content="{DynamicResource Text.openLogs}" Click="LogsFolderClick" Style="{StaticResource Quiet}" Margin="12,0,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
          <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="#2C2537" BorderBrush="#574765" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="15" Foreground="#E1D7EB" MaxHeight="95" />
              <Button Grid.Column="1" Content="×" Style="{StaticResource Quiet}" Padding="0" Click="DismissNoticeClick" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="#141619" BorderBrush="#292C32" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="218" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="28,0,22,0">
            <TextBlock x:Name="SessionTitle" Text="{DynamicResource Text.selectFirst}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Foreground="#9298A2" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            <ProgressBar x:Name="InstallBar" Height="3" Margin="0,9,0,0" Background="#2C2F37" Foreground="#BBA9F4" BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Text.cancel}" Click="CancelClick" Style="{StaticResource Quiet}" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0" />
          <Button x:Name="PlayButton" Grid.Column="2" Click="PlayClick" Style="{StaticResource LaunchAction}" VerticalAlignment="Center" Margin="0,0,24,0" IsEnabled="False">
            <Grid Width="132">
              <TextBlock Text="{DynamicResource Text.play}" VerticalAlignment="Center" />
              <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="#211B30" Stretch="Uniform" Width="11" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Button>
