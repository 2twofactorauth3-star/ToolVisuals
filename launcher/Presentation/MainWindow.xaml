            </Grid>
            <Grid x:Name="InstalledPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource Text.installed}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Text.installedHint}" Style="{StaticResource Hint}" /></StackPanel><Grid Grid.Row="1"><ListBox x:Name="InstalledList" ItemContainerStyle="{StaticResource ListItem}"><ListBox.ItemTemplate><DataTemplate><Border Background="#1B1E29" CornerRadius="11" Padding="19,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Version}" Foreground="#A3A6BC" FontSize="12" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Click="ToggleModClick" Margin="0,0,7,0" Padding="15,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="{DynamicResource Text.enable}" /><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Content" Value="{DynamicResource Text.disable}" /></DataTrigger><DataTrigger Binding="{Binding Id}" Value="toolvisuals"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="{DynamicResource Text.remove}" Click="RemoveModClick" Style="{StaticResource Quiet}" Padding="10,8" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="InstalledEmpty" Text="{DynamicResource Text.emptyInstalled}" Foreground="#9295AA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" /></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Primary}" /><Button Content="{DynamicResource Text.openProfile}" Click="ProfileFolderClick" Style="{StaticResource Quiet}" Margin="8,0" /><Button Content="{DynamicResource Text.refresh}" Click="RefreshModsClick" Style="{StaticResource Quiet}" /></StackPanel></Grid>
            <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="{DynamicResource Text.settings}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,20" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Text.account}" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,17" /><TextBlock Text="{DynamicResource Text.nickname}" Style="{StaticResource Caption}" /><TextBox x:Name="NicknameInput" MaxLength="16" /><TextBlock Text="{DynamicResource Text.nicknameHint}" Style="{StaticResource Hint}" /><Button Content="{DynamicResource Text.signIn}" Click="SignInClick" /><Button Content="{DynamicResource Text.signOut}" Click="SignOutClick" Style="{StaticResource Quiet}" Margin="0,6,0,20" /><TextBlock Text="{DynamicResource Text.msClientId}" Style="{StaticResource Caption}" /><TextBox x:Name="MicrosoftIdInput" MaxLength="36" FontSize="12" /><TextBlock Text="{DynamicResource Text.msHint}" Style="{StaticResource Hint}" /><TextBlock Text="{DynamicResource Text.cfKey}" Style="{StaticResource Caption}" Margin="0,15,0,7" /><PasswordBox x:Name="CurseKeyInput" /><TextBlock Text="{DynamicResource Text.cfHint}" Style="{StaticResource Hint}" /><Button Content="CurseForge API ↗" Click="CurseConsoleClick" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,4" /></StackPanel><StackPanel Grid.Column="2"><Grid Margin="0,0,0,13"><TextBlock Text="{DynamicResource Text.memory}" FontWeight="SemiBold" FontSize="17" /><TextBlock x:Name="MemoryLabel" HorizontalAlignment="Right" Foreground="#B9A5F5" VerticalAlignment="Center" /></Grid><Slider x:Name="MemorySlider" Minimum="2048" Maximum="32768" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" Margin="0,7,0,21" /><TextBlock Text="{DynamicResource Text.java}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" /><CheckBox x:Name="AutoJavaCheck" Content="{DynamicResource Text.autoJava}" /><TextBlock Text="Java 21" Style="{StaticResource Caption}" Margin="0,10,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBox x:Name="Java21Input" FontSize="11" /><Button Grid.Column="1" Content="…" Tag="21" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" /></Grid><TextBlock Text="Java 25" Style="{StaticResource Caption}" Margin="0,12,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions><TextBox x:Name="Java25Input" FontSize="11" /><Button Grid.Column="1" Content="…" Tag="25" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" /></Grid><TextBlock Text="{DynamicResource Text.javaHint}" Style="{StaticResource Hint}" /><TextBlock Text="Discord RPC" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,7" /><TextBlock Text="{DynamicResource Text.rpcHint}" Style="{StaticResource Hint}" /><TextBlock x:Name="RpcStatus" TextWrapping="Wrap" FontSize="11" Foreground="#817994" Margin="0,5,0,10" /></StackPanel></Grid></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0"><Button Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" /><Button Content="{DynamicResource Text.openLogs}" Click="LogsFolderClick" Style="{StaticResource Quiet}" Margin="12,0,0,0" /></StackPanel></Grid>
          </Grid>
          <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="#2C2537" BorderBrush="#574765" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#E1D7EB" MaxHeight="95" /><Button Grid.Column="1" Content="×" Style="{StaticResource Quiet}" Padding="0" Click="DismissNoticeClick" /></Grid></Border>
