      <Border Grid.Row="2" Background="#171A24" BorderBrush="#292D3B" BorderThickness="0,1,0,0"><Grid Margin="28,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="245" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="SessionTitle" Text="{DynamicResource Text.selectFirst}" FontWeight="SemiBold" FontSize="15" /><TextBlock x:Name="StatusText" Text="{DynamicResource Text.protection}" Foreground="#8D93A8" FontSize="12" Margin="0,7,0,0" /><ProgressBar x:Name="InstallBar" Height="3" Margin="0,9,24,0" Background="#2C2D40" Foreground="#B9A5F5" BorderThickness="0" Visibility="Collapsed" /></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Text.cancel}" Click="CancelClick" Style="{StaticResource Quiet}" VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0,18,0" /><Button x:Name="PlayButton" Grid.Column="2" Content="{DynamicResource Text.play}" Click="PlayClick" Style="{StaticResource Primary}" FontSize="16" Padding="20,15" VerticalAlignment="Center" IsEnabled="False" /></Grid></Border>
    </Grid>
  </Border>
</Window>
