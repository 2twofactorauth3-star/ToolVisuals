                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="Java21Input" FontSize="14" />
                      <Button Grid.Column="1" Content="…" Tag="21" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" />
                    </Grid>
                    <TextBlock Text="Java 25" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="38" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="Java25Input" FontSize="14" />
                      <Button Grid.Column="1" Content="…" Tag="25" Click="JavaBrowseClick" Padding="0" Margin="5,0,0,0" />
                    </Grid>
                    <TextBlock Text="{DynamicResource Text.javaHint}" Style="{StaticResource Hint}" />
                    <TextBlock Text="Discord RPC" FontSize="19" FontWeight="SemiBold" Margin="0,15,0,7" />
                    <TextBlock Text="{DynamicResource Text.rpcHint}" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="RpcStatus" TextWrapping="Wrap" FontSize="14" Foreground="#817994" Margin="0,5,0,10" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" />
                <Button Content="{DynamicResource Text.openLogs}" Click="LogsFolderClick" Style="{StaticResource Quiet}" Margin="12,0,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
          <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="#2C2537" BorderBrush="#574765" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="15" Foreground="#E1D7EB" MaxHeight="95" />
              <Button Grid.Column="1" Content="×" Style="{StaticResource Quiet}" Padding="0" Click="DismissNoticeClick" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="#191923" BorderBrush="#302C3D" BorderThickness="0,1,0,0">
        <Grid Margin="28,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="SessionTitle" Text="{DynamicResource Text.selectFirst}" FontWeight="SemiBold" FontSize="18" />
            <TextBlock x:Name="StatusText" Text="{DynamicResource Text.protection}" Foreground="#AFA9BF" FontSize="14" Margin="0,7,0,0" />
            <ProgressBar x:Name="InstallBar" Height="5" Margin="0,9,24,0" Background="#2C2D40" Foreground="#B9A5F5" BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Text.cancel}" Click="CancelClick" Style="{StaticResource Quiet}" VerticalAlignment="Center" Visibility="Collapsed" Margin="10,0,18,0" />
          <Button x:Name="PlayButton" Grid.Column="2" Content="{DynamicResource Text.play}" Click="PlayClick" Style="{StaticResource Primary}" FontSize="18" Padding="22,17" VerticalAlignment="Center" IsEnabled="False" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
