<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:accounts="clr-namespace:ToolLauncher.Presentation.Accounts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolLauncher.Presentation.MainWindow" Title="ToolLauncher" Icon="/ToolLauncher;component/Assets/ToolVisuals.Executable.ico" Width="1240" Height="800" MinWidth="1100" MinHeight="740" Background="#101215" Foreground="#F1F0EC" FontFamily="Segoe UI" FontSize="16" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto" TextOptions.TextHintingMode="Fixed" SizeChanged="WindowSizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="RootVisual" BorderBrush="#2A2D34" BorderThickness="1" CornerRadius="14" Background="#101215" RenderOptions.ClearTypeHint="Enabled">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="62" />
        <RowDefinition Height="*" />
        <RowDefinition Height="102" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="HeaderDrag" Background="#141619">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="218" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Image Source="{StaticResource BrandLogo}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Clip>
              <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
            </Image.Clip>
          </Image>
          <TextBlock Text="ToolLauncher" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
          <TextBlock Text="MINECRAFT" Foreground="#777D87" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="/" Foreground="#434750" Margin="14,0" VerticalAlignment="Center" />
          <TextBlock x:Name="CurrentPageTitle" Text="{DynamicResource Text.home}" Foreground="#D1D2D7" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button x:Name="LanguageButton" Content="EN" Click="LanguageClick" Style="{StaticResource Quiet}" FontSize="14" Padding="12,8" Margin="0,0,18,0" />
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="MinimizeClick" ToolTip="{DynamicResource Text.minimize}">
            <Path Data="M 0,5 L 11,5" Style="{StaticResource LineIcon}" />
          </Button>
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="MaximizeClick" ToolTip="{DynamicResource Text.maximize}">
            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Style="{StaticResource LineIcon}" />
          </Button>
          <Button Width="38" Height="34" Padding="13" Style="{StaticResource Quiet}" Click="CloseClick" ToolTip="{DynamicResource Text.close}">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Style="{StaticResource LineIcon}" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="218" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#141619" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="16,26,16,0">
            <Button x:Name="HomeNav" Click="NavigationClick" Tag="home" Style="{StaticResource Navigation}" Background="{StaticResource NavSelected}" Foreground="#F4EFFF">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,9 L 10,1 L 19,9 M 4,7 L 4,19 L 16,19 L 16,7 M 8,19 L 8,13 L 12,13 L 12,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.home}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModsNav" Click="NavigationClick" Tag="mods" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,4 L 10,0 L 19,4 L 19,15 L 10,20 L 1,15 Z M 1,4 L 10,9 L 19,4 M 10,9 L 10,20" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.mods}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="InstalledNav" Click="NavigationClick" Tag="installed" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 12,1 L 19,1 L 19,8 L 12,8 Z M 1,12 L 8,12 L 8,19 L 1,19 Z M 12,12 L 19,12 L 19,19 L 12,19 Z" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.installed}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="AccountsNav" Click="NavigationClick" Tag="accounts" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 6,5 A 4,4 0 1 1 14,5 A 4,4 0 1 1 6,5 M 1,20 C 1,10 19,10 19,20" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.accounts}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNav" Click="NavigationClick" Tag="settings" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 0,5 L 20,5 M 0,15 L 20,15 M 7,1 L 7,9 M 14,11 L 14,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.settings}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="18,0,18,20">
            <Button Content="{DynamicResource Text.community}" Click="CommunityClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" />
            <Button Content="{DynamicResource Text.source}" Click="SourceClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" Margin="0,0,0,12" />
            <Border Background="#1D1F25" CornerRadius="10" Padding="13">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" Background="#30283E" CornerRadius="10">
                    <Path Data="M 6,5 A 4,4 0 1 1 14,5 A 4,4 0 1 1 6,5 M 1,20 C 1,10 19,10 19,20" Style="{StaticResource LineIcon}" Width="18" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#C4ACEF" />
                  </Border>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountName" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountKind" Foreground="#A5A1B8" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
                <Button Content="{DynamicResource Text.chooseAccount}" Click="AccountSettingsClick" Background="#2B2D36" Padding="8,8" FontSize="14" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <Grid x:Name="ContentArea" Grid.Column="1" Margin="28,26,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="PageHost" Background="#101215">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,7,0">
                <Border x:Name="HeroSurface" Height="164" CornerRadius="12">
                  <Border.Background>
                    <ImageBrush ImageSource="{StaticResource Landscape}" Stretch="UniformToFill" AlignmentY="Center" />
                  </Border.Background>
                  <Border CornerRadius="12">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F0101215" Offset="0" />
                        <GradientStop Color="#A0101215" Offset="0.55" />
                        <GradientStop Color="#30101215" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="26,22" VerticalAlignment="Center">
                      <TextBlock x:Name="HeroBuildLabel" Text="TOOLVISUALS" FontSize="14" Foreground="#C9BAEE" FontWeight="SemiBold" />
                      <TextBlock x:Name="HeroTitleText" Text="Minecraft" FontSize="36" FontWeight="SemiBold" Margin="0,9,0,0" />
                    </StackPanel>
                  </Border>
                </Border>
                <Grid Margin="0,24,0,12">
                  <TextBlock Text="{DynamicResource Text.choose}" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource Text.profileHint}" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ListBox x:Name="VersionList" SelectionChanged="VersionChanged" ItemContainerStyle="{StaticResource VersionItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel MinHeight="52">
                        <TextBlock Text="{Binding Minecraft}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Fabric" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,24,10,0">
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{DynamicResource Text.launchAccount}" Style="{StaticResource Caption}" />
                    <ComboBox x:Name="HomeAccountPicker" DisplayMemberPath="Label" SelectionChanged="AccountSelected" />
                    <Button Content="{DynamicResource Text.chooseAccount}" Click="AccountSettingsClick" Style="{StaticResource Quiet}" FontSize="14" HorizontalAlignment="Left" Padding="0,8" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Text.sessionSettings}" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="HomeRuntimeText" FontSize="15" Margin="0,8,0,3" TextWrapping="Wrap" />
                    <Button Content="{DynamicResource Text.launchSettingsLink}" Click="GameSettingsClick" Style="{StaticResource Quiet}" FontSize="14" HorizontalAlignment="Left" Padding="0,8" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="ModsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Text.mods}" FontSize="29" FontWeight="SemiBold" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="SearchInput" KeyDown="SearchKey" />
                  <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource Text.search}" Foreground="#797E96" Margin="13,10" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="2" Content="{DynamicResource Text.searchButton}" Click="SearchClick" Style="{StaticResource Primary}" />
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="CatalogList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#171A1F" CornerRadius="0" Padding="17,19" BorderBrush="#2B2F36" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="142" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" Foreground="#A4A8BB" FontSize="15" TextWrapping="Wrap" MaxHeight="48" LineHeight="23" Margin="0,7,0,8" />
                            <TextBlock Foreground="#8C85A2" FontSize="14">
                              <Run Text="{Binding Author, Mode=OneWay}" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding Source, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Text.install}" Style="{StaticResource Primary}" Click="InstallClick" Padding="12,8" IsEnabled="{DynamicResource CanModifyMods}" />
                            <Button Content="{DynamicResource Text.website}" Style="{StaticResource Quiet}" Click="ModWebsiteClick" FontSize="14" Padding="7,6" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CatalogEmpty" Text="{DynamicResource Text.selectFirst}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9295AA" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
              </Grid>
              <DockPanel x:Name="CatalogActions" Grid.Row="3" Margin="0,8,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Quiet}" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="PreviousCatalogPage" Content="{DynamicResource Text.previous}" Click="PreviousClick" Style="{StaticResource Quiet}" />
                  <TextBlock x:Name="PageNumber" Text="1" VerticalAlignment="Center" Margin="10,0" Foreground="#969BAF" />
                  <Button x:Name="NextCatalogPage" Content="{DynamicResource Text.next}" Click="NextClick" Style="{StaticResource Quiet}" />
                </StackPanel>
              </DockPanel>
            </Grid>
            <Grid x:Name="InstalledPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Text.installed}" FontSize="29" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Text.installedHint}" Style="{StaticResource Hint}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ListBox x:Name="InstalledList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#171A1F" CornerRadius="0" Padding="17,19" BorderBrush="#2B2F36" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="244" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Version}" Foreground="#A3A6BC" FontSize="15" Margin="0,6,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="ToggleModClick" Margin="0,0,7,0" Padding="15,8">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModMutationAction}">
                                  <Setter Property="Content" Value="{DynamicResource Text.enable}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                      <Setter Property="Content" Value="{DynamicResource Text.disable}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Text.remove}" Click="RemoveModClick" Style="{StaticResource ModMutationAction}" Padding="10,8" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="InstalledEmpty" Text="{DynamicResource Text.emptyInstalled}" Foreground="#9295AA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
              </Grid>
              <StackPanel x:Name="ModActions" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Primary}" />
                <Button Content="{DynamicResource Text.openProfile}" Click="ProfileFolderClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button Content="{DynamicResource Text.refresh}" Click="RefreshModsClick" Style="{StaticResource Quiet}" />
              </StackPanel>
            </Grid>
            <Grid x:Name="AccountsPage" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Text.accounts}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,22" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountFields" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,18,0">
                  <TextBlock Text="{DynamicResource Text.savedAccounts}" Style="{StaticResource Caption}" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AccountPicker" DisplayMemberPath="Label" SelectionChanged="AccountSelected" MinWidth="300" />
                    <Button Grid.Column="2" Content="{DynamicResource Text.remove}" Click="RemoveAccountClick" ToolTip="{DynamicResource Text.removeAccount}" />
                  </Grid>
                  <TextBlock x:Name="AccountSelectionHint" Style="{StaticResource Hint}" FontSize="14" />
                  <Button Content="{DynamicResource Text.importAccounts}" Click="AccountImportClick" HorizontalAlignment="Left" Margin="0,0,0,22" />
                  <TextBlock Text="{DynamicResource Text.nickname}" Style="{StaticResource Caption}" />
                  <TextBox x:Name="NicknameInput" MaxLength="16" />
                  <TextBlock Text="{DynamicResource Text.nicknameHint}" Style="{StaticResource Hint}" />
                  <Button Content="{DynamicResource Text.signOut}" Click="SignOutClick" HorizontalAlignment="Left" />
                  <Expander Header="Microsoft" Foreground="{StaticResource Muted}" Margin="0,24,0,0" IsExpanded="False">
                    <StackPanel Margin="0,15,0,0">
                      <TextBlock Text="{DynamicResource Text.msClientId}" Style="{StaticResource Caption}" />
                      <TextBox x:Name="MicrosoftIdInput" MaxLength="36" FontSize="14" />
                      <TextBlock Text="{DynamicResource Text.msHint}" Style="{StaticResource Hint}" />
                      <Button Content="{DynamicResource Text.signIn}" Click="SignInClick" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
              <Button x:Name="SaveAccountSettingsButton" Grid.Row="2" Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" />
            </Grid>
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Text.settings}" FontSize="29" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsStateText" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="GameSettingsTab" Content="{DynamicResource Text.gameSettings}" Tag="game" Click="SettingsCategoryClick" Background="{StaticResource NavSelected}" />
                <Button x:Name="AppearanceSettingsTab" Content="{DynamicResource Text.appearance}" Tag="appearance" Click="SettingsCategoryClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button x:Name="JavaSettingsTab" Content="Java" Tag="java" Click="SettingsCategoryClick" Style="{StaticResource Quiet}" />
              </StackPanel>
              <Grid x:Name="SettingsFields" Grid.Row="2">
                <ScrollViewer x:Name="GameSettingsPanel" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,18,0" MaxWidth="640" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,10">
                      <TextBlock Text="{DynamicResource Text.memory}" FontWeight="SemiBold" FontSize="19" />
                      <TextBlock x:Name="MemoryLabel" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" />
                    </Grid>
                    <Slider x:Name="MemorySlider" Minimum="1024" Maximum="1024" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" Margin="0,7,0,8" MinWidth="480" />
                    <TextBlock x:Name="MemoryBudgetHint" Style="{StaticResource Hint}" />
                    <Button Content="{DynamicResource Text.resetMemory}" Click="RecommendedMemoryClick" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Padding="0,8" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,24" />
                    <TextBlock Text="{DynamicResource Text.afterLaunch}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="MinimizeOnLaunchCheck" Content="{DynamicResource Text.minimizeOnLaunch}" />
                    <TextBlock Text="{DynamicResource Text.gameOptionsHint}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AppearanceSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,18,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource Text.appearance}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <CheckBox x:Name="AnimationsCheck" Content="{DynamicResource Text.interfaceAnimations}" />
                    <TextBlock Text="{DynamicResource Text.animationsHint}" Style="{StaticResource Hint}" />
                    <CheckBox x:Name="CompactModeCheck" Content="{DynamicResource Text.compactInterface}" />
                    <TextBlock Text="{DynamicResource Text.compactHint}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="JavaSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,0,18,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource Text.java}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="AutoJavaCheck" Content="{DynamicResource Text.autoJava}" />
                    <TextBlock Text="{DynamicResource Text.javaHint}" Style="{StaticResource Hint}" />
                    <StackPanel x:Name="JavaPaths" MinWidth="480">
                      <TextBlock Text="Java 21" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="Java21Input" FontSize="14" />
                        <Button Grid.Column="1" Content="…" Tag="21" Click="JavaBrowseClick" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource Text.browse}" />
                      </Grid>
                      <TextBlock Text="Java 25" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="Java25Input" FontSize="14" />
                        <Button Grid.Column="1" Content="…" Tag="25" Click="JavaBrowseClick" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource Text.browse}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="SaveSettingsButton" Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" />
                <Button x:Name="DiscardSettingsButton" Content="{DynamicResource Text.discard}" Click="DiscardSettingsClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button Content="{DynamicResource Text.openLogs}" Click="LogsFolderClick" Style="{StaticResource Quiet}" />
              </StackPanel>
            </Grid>
          </Grid>
          <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="#2C2537" BorderBrush="#574765" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="15" Foreground="#E1D7EB" MaxHeight="95" />
              <Button Grid.Column="1" Content="×" Style="{StaticResource Quiet}" Padding="0" Click="DismissNoticeClick" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="#141619" BorderBrush="#292C32" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="218" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="28,0,22,0">
            <TextBlock x:Name="SessionTitle" Text="{DynamicResource Text.selectFirst}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusText" Foreground="#9298A2" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            <ProgressBar x:Name="InstallBar" Height="3" Margin="0,9,0,0" Background="#2C2F37" Foreground="#BBA9F4" BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>
          <Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Text.cancel}" Click="CancelClick" Style="{StaticResource Quiet}" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0" />
          <Button x:Name="PlayButton" Grid.Column="2" Click="PlayClick" Style="{StaticResource LaunchAction}" VerticalAlignment="Center" Margin="0,0,24,0" IsEnabled="False">
            <Grid Width="132">
              <TextBlock Text="{DynamicResource Text.play}" VerticalAlignment="Center" />
              <Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="#211B30" Stretch="Uniform" Width="11" Height="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>
      </Border>
      <accounts:AccountImportPanel x:Name="AccountImportOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
