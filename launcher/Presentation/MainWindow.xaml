                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Image Source="{StaticResource BrandLogo}" Width="42" Height="42" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
