<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:accounts="clr-namespace:ToolLauncher.Presentation.Accounts" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolLauncher.Presentation.MainWindow" Title="ToolLauncher" Icon="/ToolLauncher;component/Assets/ToolVisuals.Executable.ico" Width="1280" Height="820" MinWidth="1100" MinHeight="740" Background="#100F14" Foreground="#F5F3FA" FontFamily="Segoe UI" FontSize="16" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed" SizeChanged="WindowSizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="RootVisual" BorderBrush="#302B3B" BorderThickness="1" CornerRadius="16" Background="{StaticResource Surface}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="94" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid Margin="20,27,12,30" MouseLeftButtonDown="HeaderDrag" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Image Source="{StaticResource BrandLogo}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip><RectangleGeometry Rect="0,0,38,38" RadiusX="10" RadiusY="10" /></Image.Clip>
            </Image>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock Text="ToolVisuals" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="Launcher" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Margin="12,0">
            <Button x:Name="HomeNav" Click="NavigationClick" Tag="home" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,9 L 10,1 L 19,9 M 4,7 L 4,19 L 16,19 L 16,7 M 8,19 L 8,13 L 12,13 L 12,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.home}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ModsNav" Click="NavigationClick" Tag="mods" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,4 L 10,0 L 19,4 L 19,15 L 10,20 L 1,15 Z M 1,4 L 10,9 L 19,4 M 10,9 L 10,20" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.mods}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="InstalledNav" Click="NavigationClick" Tag="installed" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 12,1 L 19,1 L 19,8 L 12,8 Z M 1,12 L 8,12 L 8,19 L 1,19 Z M 12,12 L 19,12 L 19,19 L 12,19 Z" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.installed}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="AccountsNav" Click="NavigationClick" Tag="accounts" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 6,5 A 4,4 0 1 1 14,5 A 4,4 0 1 1 6,5 M 1,20 C 1,10 19,10 19,20" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.accounts}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="SettingsNav" Click="NavigationClick" Tag="settings" Style="{StaticResource Navigation}">
              <StackPanel Orientation="Horizontal">
                <Path Data="M 0,5 L 20,5 M 0,15 L 20,15 M 7,1 L 7,9 M 14,11 L 14,19" Style="{StaticResource NavIcon}" />
                <TextBlock Text="{DynamicResource Text.settings}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="12,16,12,22">
            <Border Height="1" Background="{StaticResource Line}" Margin="10,0,10,14" />
            <Button Content="{DynamicResource Text.community}" Click="CommunityClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" Padding="12,9" />
            <Button Content="{DynamicResource Text.source}" Click="SourceClick" Style="{StaticResource Quiet}" HorizontalContentAlignment="Left" FontSize="14" Padding="12,9" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Grid.Row="0" MouseLeftButtonDown="HeaderDrag" Background="Transparent" Margin="22,0,12,0">
        <TextBlock x:Name="CurrentPageTitle" Text="{DynamicResource Text.home}" FontSize="28" FontWeight="Bold" Foreground="#F5F5F7" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Content="EN" Click="LanguageClick" Style="{StaticResource Quiet}" Padding="11,8" FontSize="14" Margin="0,0,14,0" />
          <Button Width="36" Height="34" Padding="12" Style="{StaticResource Quiet}" Click="MinimizeClick" ToolTip="{DynamicResource Text.minimize}"><Path Data="M 0,5 L 11,5" Style="{StaticResource LineIcon}" /></Button>
          <Button Width="36" Height="34" Padding="12" Style="{StaticResource Quiet}" Click="MaximizeClick" ToolTip="{DynamicResource Text.maximize}"><Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Style="{StaticResource LineIcon}" /></Button>
          <Button Width="36" Height="34" Padding="12" Style="{StaticResource Quiet}" Click="CloseClick" ToolTip="{DynamicResource Text.close}"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Style="{StaticResource LineIcon}" /></Button>
        </StackPanel>
      </Grid>
      <Grid x:Name="ContentArea" Grid.Column="1" Grid.Row="1" Margin="20,0,20,16">
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid x:Name="PageHost">
          <Grid x:Name="HomePage">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="HeroSurface" CornerRadius="18" BorderBrush="#3A3D44" BorderThickness="1" RenderOptions.BitmapScalingMode="HighQuality">
              <Border.Background><ImageBrush ImageSource="{StaticResource Landscape}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background>
              <Grid>
                <Border CornerRadius="18">
                  <Border.Background><LinearGradientBrush StartPoint="0,0.6" EndPoint="0.9,0.6"><GradientStop Color="#8C0C1015" Offset="0" /><GradientStop Color="#000C1015" Offset="0.85" /></LinearGradientBrush></Border.Background>
                </Border>
                <Border CornerRadius="18">
                  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#000C1015" Offset="0.25" /><GradientStop Color="#CE0C1015" Offset="1" /></LinearGradientBrush></Border.Background>
                </Border>
                <StackPanel x:Name="HeroIdentity" VerticalAlignment="Bottom" Margin="30,24,30,28">
                  <TextBlock Text="MINECRAFT JAVA EDITION" FontSize="15" Foreground="#D2D4DB" Margin="0,0,0,8" />
                  <TextBlock x:Name="HeroTitleText" Text="ToolVisuals" FontSize="54" FontWeight="SemiBold" Foreground="#FFFFFF" />
                  <StackPanel Orientation="Horizontal" Margin="2,12,0,0"><Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock x:Name="HeroBuildLabel" FontSize="16" Foreground="#ECECF1" /></StackPanel>
                </StackPanel>
                <Button x:Name="SceneCredit" Content="Xbox México · CC BY 3.0 ↗" Click="SceneCreditClick" Style="{StaticResource Quiet}" FontSize="12" FontWeight="Normal" Foreground="#E1E5ED" Background="#C0141B26" Padding="8,6" Margin="12" VerticalAlignment="Top" HorizontalAlignment="Right" ToolTip="Minecraft — Frozen ocean · Xbox México · CC BY 3.0" />
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Button x:Name="QuickModsButton" Click="NavigationClick" Tag="installed" Style="{StaticResource QuickAction}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                  <Path Data="M 1,1 L 8,1 L 8,8 L 1,8 Z M 12,1 L 19,1 L 19,8 L 12,8 Z M 1,12 L 8,12 L 8,19 L 1,19 Z M 12,12 L 19,12 L 19,19 L 12,19 Z" Style="{StaticResource LineIcon}" Width="24" Height="24" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.installed}" FontSize="18" />
                    <TextBlock x:Name="HomeModsHint" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Path Grid.Column="3" Data="M 1,9 L 19,9 M 12,2 L 19,9 L 12,16" Style="{StaticResource LineIcon}" Width="18" Height="18" Opacity="0.65" />
                </Grid>
              </Button>
              <Button x:Name="QuickFolderButton" Grid.Column="2" Click="ProfileFolderClick" Style="{StaticResource QuickAction}" IsEnabled="{DynamicResource CanOpenProfile}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="18" /><ColumnDefinition /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                  <Path Data="M 1,4 L 8,4 L 11,7 L 23,7 L 23,21 L 1,21 Z" Style="{StaticResource LineIcon}" Width="24" Height="24" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Text.openProfile}" FontSize="18" />
                    <TextBlock x:Name="HomeFolderHint" FontSize="14" FontWeight="Normal" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Path Grid.Column="3" Data="M 1,9 L 19,9 M 12,2 L 19,9 L 12,16" Style="{StaticResource LineIcon}" Width="18" Height="18" Opacity="0.65" />
                </Grid>
              </Button>
            </Grid>
          </Grid>
            <Grid x:Name="ModsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>

              </StackPanel>
              <Grid Grid.Row="1" Margin="0,4,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="SearchInput" KeyDown="SearchKey" />
                  <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource Text.search}" Foreground="#797E96" Margin="13,10" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="2" Content="{DynamicResource Text.searchButton}" Click="SearchClick" Style="{StaticResource Primary}" />
              </Grid>
              <Grid Grid.Row="2">
                <ListBox x:Name="CatalogList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="20,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="142" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Description}" Foreground="#A4A8BB" FontSize="15" TextWrapping="Wrap" MaxHeight="48" LineHeight="23" Margin="0,7,0,8" />
                            <TextBlock Foreground="#8C85A2" FontSize="14">
                              <Run Text="{Binding Author, Mode=OneWay}" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding Source, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Text.install}" Style="{StaticResource Primary}" Click="InstallClick" Padding="12,8" IsEnabled="{DynamicResource CanModifyMods}" />
                            <Button Content="{DynamicResource Text.website}" Style="{StaticResource Quiet}" Click="ModWebsiteClick" FontSize="14" Padding="7,6" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="CatalogEmpty" Text="{DynamicResource Text.selectFirst}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9295AA" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
              </Grid>
              <DockPanel x:Name="CatalogActions" Grid.Row="3" Margin="0,8,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Quiet}" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="PreviousCatalogPage" Content="{DynamicResource Text.previous}" Click="PreviousClick" Style="{StaticResource Quiet}" />
                  <TextBlock x:Name="PageNumber" Text="1" VerticalAlignment="Center" Margin="10,0" Foreground="#969BAF" />
                  <Button x:Name="NextCatalogPage" Content="{DynamicResource Text.next}" Click="NextClick" Style="{StaticResource Quiet}" />
                </StackPanel>
              </DockPanel>
            </Grid>
            <Grid x:Name="InstalledPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>

                <TextBlock Text="{DynamicResource Text.installedHint}" Style="{StaticResource Hint}" />
              </StackPanel>
              <Grid Grid.Row="1">
                <ListBox x:Name="InstalledList" ItemContainerStyle="{StaticResource ListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Card}" CornerRadius="12" Padding="20,18" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="244" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Version}" Foreground="#A3A6BC" FontSize="15" Margin="0,6,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="ToggleModClick" Margin="0,0,7,0" Padding="15,8">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModMutationAction}">
                                  <Setter Property="Content" Value="{DynamicResource Text.enable}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                      <Setter Property="Content" Value="{DynamicResource Text.disable}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Content="{DynamicResource Text.remove}" Click="RemoveModClick" Style="{StaticResource ModMutationAction}" Padding="10,8" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="InstalledEmpty" Text="{DynamicResource Text.emptyInstalled}" Foreground="#9295AA" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
              </Grid>
              <StackPanel x:Name="ModActions" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource Text.import}" Click="ImportClick" Style="{StaticResource Primary}" />
                <Button Content="{DynamicResource Text.openProfile}" Click="ProfileFolderClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button Content="{DynamicResource Text.refresh}" Click="RefreshModsClick" Style="{StaticResource Quiet}" />
              </StackPanel>
            </Grid>
            <Grid x:Name="AccountsPage" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Background="{StaticResource Card}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                <StackPanel x:Name="AccountFields" MaxWidth="680" HorizontalAlignment="Stretch" Margin="22,18">
                  <TextBlock Text="{DynamicResource Text.savedAccounts}" Style="{StaticResource Caption}" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AccountPicker" DisplayMemberPath="Label" SelectionChanged="AccountSelected" MinWidth="300" />
                    <Button Grid.Column="2" Content="{DynamicResource Text.remove}" Click="RemoveAccountClick" ToolTip="{DynamicResource Text.removeAccount}" />
                  </Grid>
                  <TextBlock x:Name="AccountSelectionHint" Style="{StaticResource Hint}" FontSize="14" LineHeight="18" Margin="0,8,0,10" />
                  <Button Content="{DynamicResource Text.importAccounts}" Click="AccountImportClick" HorizontalAlignment="Left" Margin="0,0,0,16" />
                  <TextBlock Text="{DynamicResource Text.nickname}" Style="{StaticResource Caption}" />
                  <TextBox x:Name="NicknameInput" MaxLength="16" />
                  <TextBlock Text="{DynamicResource Text.nicknameHint}" Style="{StaticResource Hint}" FontSize="14" LineHeight="20" Margin="0,4,0,12" />
                  <Button Content="{DynamicResource Text.signOut}" Click="SignOutClick" HorizontalAlignment="Left" />
                  <Expander Header="Microsoft" Foreground="{StaticResource Muted}" Margin="0,16,0,0" IsExpanded="False">
                    <StackPanel Margin="0,15,0,0">
                      <TextBlock Text="{DynamicResource Text.msClientId}" Style="{StaticResource Caption}" />
                      <TextBox x:Name="MicrosoftIdInput" MaxLength="36" FontSize="14" />
                      <TextBlock Text="{DynamicResource Text.msHint}" Style="{StaticResource Hint}" />
                      <Button Content="{DynamicResource Text.signIn}" Click="SignInClick" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              </ScrollViewer>
              <Button x:Name="SaveAccountSettingsButton" Grid.Row="2" Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,18,0,0" />
            </Grid>
            <Grid x:Name="SettingsPage" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,20">

                <TextBlock x:Name="SettingsStateText" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="GameSettingsTab" Content="{DynamicResource Text.gameSettings}" Tag="game" Click="SettingsCategoryClick" Background="{StaticResource NavSelected}" />
                <Button x:Name="AppearanceSettingsTab" Content="{DynamicResource Text.appearance}" Tag="appearance" Click="SettingsCategoryClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button x:Name="JavaSettingsTab" Content="Java" Tag="java" Click="SettingsCategoryClick" Style="{StaticResource Quiet}" />
              </StackPanel>
              <Grid x:Name="SettingsFields" Grid.Row="2">
                <ScrollViewer x:Name="GameSettingsPanel" VerticalScrollBarVisibility="Auto">
                  <Border Background="{StaticResource Card}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                  <StackPanel Margin="22,20" MaxWidth="720" HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,10">
                      <TextBlock Text="{DynamicResource Text.memory}" FontWeight="SemiBold" FontSize="19" />
                      <TextBlock x:Name="MemoryLabel" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" />
                    </Grid>
                    <Slider x:Name="MemorySlider" Minimum="1024" Maximum="1024" TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="MemoryChanged" Margin="0,7,0,8" MinWidth="480" />
                    <TextBlock x:Name="MemoryBudgetHint" Style="{StaticResource Hint}" />
                    <Button Content="{DynamicResource Text.resetMemory}" Click="RecommendedMemoryClick" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Padding="0,8" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,24" />
                    <TextBlock Text="{DynamicResource Text.gcTitle}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock Text="{DynamicResource Text.gcProfileHint}" Style="{StaticResource Hint}" Margin="0,0,0,14" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Text.gcProfile}" Style="{StaticResource Caption}" />
                      <TextBlock Grid.Column="2" Text="{DynamicResource Text.gcTitle}" Style="{StaticResource Caption}" />
                      <ComboBox x:Name="CollectorProfilePicker" Grid.Row="1" DisplayMemberPath="Minecraft" AutomationProperties.Name="{DynamicResource Text.gcProfile}" />
                      <ComboBox x:Name="CollectorPicker" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{DynamicResource Text.gcTitle}" />
                    </Grid>
                    <Button Content="{DynamicResource Text.gcDetails}" Click="CollectorDetailsClick" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Padding="0,8" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,24" />
                    <TextBlock Text="{DynamicResource Text.afterLaunch}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="MinimizeOnLaunchCheck" Content="{DynamicResource Text.minimizeOnLaunch}" />
                  </StackPanel>
                </Border>
                </ScrollViewer>
                <ScrollViewer x:Name="AppearanceSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <Border Background="{StaticResource Card}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                  <StackPanel Margin="22,20" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource Text.appearance}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <CheckBox x:Name="AnimationsCheck" Content="{DynamicResource Text.interfaceAnimations}" />
                    <TextBlock Text="{DynamicResource Text.animationsHint}" Style="{StaticResource Hint}" />
                    <CheckBox x:Name="CompactModeCheck" Content="{DynamicResource Text.compactInterface}" />
                    <TextBlock Text="{DynamicResource Text.compactHint}" Style="{StaticResource Hint}" />
                  </StackPanel>
                </Border>
                </ScrollViewer>
                <ScrollViewer x:Name="JavaSettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <Border Background="{StaticResource Card}" CornerRadius="16" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Top">
                  <StackPanel Margin="22,20" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="{DynamicResource Text.java}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <CheckBox x:Name="AutoJavaCheck" Content="{DynamicResource Text.autoJava}" />
                    <TextBlock Text="{DynamicResource Text.javaHint}" Style="{StaticResource Hint}" />
                    <StackPanel x:Name="JavaPaths" MinWidth="480">
                      <TextBlock Text="Java 21" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="Java21Input" FontSize="14" />
                        <Button Grid.Column="1" Content="…" Tag="21" Click="JavaBrowseClick" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource Text.browse}" />
                      </Grid>
                      <TextBlock Text="Java 25" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="Java25Input" FontSize="14" />
                        <Button Grid.Column="1" Content="…" Tag="25" Click="JavaBrowseClick" Padding="0" Margin="8,0,0,0" ToolTip="{DynamicResource Text.browse}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
                </ScrollViewer>
              </Grid>
              <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,20,0,0">
                <Button x:Name="SaveSettingsButton" Content="{DynamicResource Text.save}" Click="SaveSettingsClick" Style="{StaticResource Primary}" />
                <Button x:Name="DiscardSettingsButton" Content="{DynamicResource Text.discard}" Click="DiscardSettingsClick" Style="{StaticResource Quiet}" Margin="8,0" />
                <Button Content="{DynamicResource Text.openLogs}" Click="LogsFolderClick" Style="{StaticResource Quiet}" />
              </StackPanel>
            </Grid>
        </Grid>
          <Border x:Name="NoticeBorder" Grid.Row="1" Visibility="Collapsed" Background="#2C2537" BorderBrush="#574765" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="15" Foreground="#E1D7EB" MaxHeight="95" />
              <Button Grid.Column="1" Content="×" Style="{StaticResource Quiet}" Padding="0" Click="DismissNoticeClick" />
            </Grid>
          </Border>
      </Grid>
      <Border x:Name="LaunchDock" Grid.Column="1" Grid.Row="2" CornerRadius="16" Background="{StaticResource CardFill}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="24,0,24,22" Padding="24,20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition Width="166" /><ColumnDefinition Width="14" /><ColumnDefinition Width="160" /><ColumnDefinition Width="14" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="LaunchTitleGap" Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock x:Name="LaunchTitleText" Text="{DynamicResource Text.launchGame}" FontSize="24" FontWeight="Bold" Grid.ColumnSpan="3" />
          <StackPanel x:Name="LaunchStatePanel" Grid.Column="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border x:Name="LaunchStateDot" Width="9" Height="9" CornerRadius="5" Background="#4BCB75" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock x:Name="LaunchStateText" FontSize="15" Foreground="#D4D5DC" VerticalAlignment="Center" /></StackPanel>
          <TextBlock Grid.Row="2" Text="{DynamicResource Text.launchAccount}" Foreground="{StaticResource Muted}" FontSize="14" />
          <TextBlock Grid.Column="2" Grid.Row="2" Text="{DynamicResource Text.launchVersion}" Foreground="{StaticResource Muted}" FontSize="14" />
          <ComboBox x:Name="HomeAccountPicker" Grid.Row="4" SelectionChanged="AccountSelected" ToolTip="{DynamicResource Text.launchAccount}" MinHeight="54">
            <ComboBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Label}"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="6" Background="#302A3D"><Path Data="M 6,5 A 4,4 0 1 1 14,5 A 4,4 0 1 1 6,5 M 1,20 C 1,10 19,10 19,20" Stroke="#CBB9F2" StrokeThickness="1.5" Stretch="Uniform" Width="17" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="2" Text="{Binding Profile.Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Grid Grid.Column="2" Grid.Row="4">
            <ComboBox x:Name="VersionList" DisplayMemberPath="Minecraft" SelectionChanged="VersionChanged" ToolTip="{DynamicResource Text.launchVersion}" MinHeight="54" FontSize="18" />
            <TextBlock Text="{DynamicResource Text.pickVersion}" Foreground="{StaticResource Muted}" Margin="13,0,30,0" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=VersionList}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </Grid>
          <Button x:Name="LaunchSettingsButton" Grid.Column="4" Grid.Row="4" Click="GameSettingsClick" Padding="12" Background="{StaticResource InputFill}" BorderBrush="{StaticResource InputLine}" ToolTip="{DynamicResource Text.launchSettingsLink}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions><Path Data="M 8,1 L 12,1 L 13,4 L 16,6 L 19,6 L 21,10 L 19,13 L 19,16 L 15,18 L 12,17 L 9,19 L 5,17 L 5,14 L 2,11 L 3,7 L 6,6 Z M 8,10 A 3,3 0 1 1 14,10 A 3,3 0 1 1 8,10" Style="{StaticResource LineIcon}" Width="20" Height="20" /><TextBlock x:Name="HomeRuntimeText" Grid.Column="2" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Center" /></Grid></Button>
          <Button x:Name="PlayButton" Grid.Column="6" Grid.Row="4" Click="PlayClick" Style="{StaticResource LaunchAction}" IsEnabled="False"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock x:Name="PlayActionText" Text="{DynamicResource Text.play}" VerticalAlignment="Center" /><Path Data="M 0,0 L 8,5 L 0,10 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="12" Height="14" VerticalAlignment="Center" Margin="12,0,0,0" /></StackPanel></Button>
          <Grid x:Name="LaunchStatus" Grid.Row="5" Grid.ColumnSpan="7" Margin="0,14,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="14" TextTrimming="CharacterEllipsis" /><ProgressBar x:Name="InstallBar" Height="4" Margin="0,10,0,0" Background="#303139" Foreground="{StaticResource Accent}" BorderThickness="0" Visibility="Collapsed" /></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="{DynamicResource Text.cancel}" Click="CancelClick" Style="{StaticResource Quiet}" Padding="12,6" Margin="12,0,0,0" Visibility="Collapsed" /></Grid>
        </Grid>
      </Border>
      <accounts:AccountImportPanel x:Name="AccountImportOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" />
    </Grid>
  </Border>
</Window>
