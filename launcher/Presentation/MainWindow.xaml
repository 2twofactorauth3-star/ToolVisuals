                            <TextBlock Foreground="#8C85A2" FontSize="14">
                              <Run Text="{Binding Author, Mode=OneWay}" />
                              <Run Text="  ·  " />
                              <Run Text="{Binding Source, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="{DynamicResource Text.install}" Style="{StaticResource Primary}" Click="InstallClick" Padding="12,8" />
                            <Button Content="{DynamicResource Text.website}" Style="{StaticResource Quiet}" Click="ModWebsiteClick" FontSize="14" Padding="7,6" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
