                          <Path Data="M 222,178 L 240,169 L 240,188 L 222,198 Z M 262,154 L 280,145 L 280,164 L 262,173 Z" Fill="#463451" />
                          <Path Data="M 256,46 L 282,33 L 307,46 L 281,60 Z" Fill="#D2C4FF" />
