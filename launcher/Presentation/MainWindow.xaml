            <Button x:Name="InstalledNav" Click="NavigationClick" Tag="installed" HorizontalContentAlignment="Left" Style="{StaticResource Quiet}" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="27" FontSize="17" /><TextBlock Text="{DynamicResource Text.installed}" VerticalAlignment="Center" /></StackPanel></Button>
