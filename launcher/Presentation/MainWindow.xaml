<Window x:Class="ToolLauncher.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ToolLauncher" Icon="/ToolLauncher;component/Assets/ToolVisuals.ico" Width="1220" Height="820" MinWidth="1040" MinHeight="710" Background="#11141C" Foreground="#ECECF4" FontFamily="Segoe UI" FontSize="14" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border x:Name="RootVisual" BorderBrush="#323543" BorderThickness="1" CornerRadius="14" Background="#11141C" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="100" /></Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="HeaderDrag" Background="Transparent">
        <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center"><Image Source="{StaticResource BrandLogo}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="10" RadiusY="10" /></Image.Clip></Image><TextBlock Text="ToolLauncher" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" /><Border Background="#242232" CornerRadius="5" Padding="7,3" Margin="10,2,0,0" VerticalAlignment="Center"><TextBlock Text="1.0" FontSize="11" Foreground="#BFB0E5" /></Border></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"><Button x:Name="LanguageButton" Content="EN" Click="LanguageClick" Style="{StaticResource Quiet}" Padding="12,8" Margin="0,0,16,0" /><Button Content="−" FontSize="20" Width="38" Padding="0,5" Style="{StaticResource Quiet}" Click="MinimizeClick" /><Button Content="□" FontSize="16" Width="38" Padding="0,6" Style="{StaticResource Quiet}" Click="MaximizeClick" /><Button Content="×" FontSize="23" Width="38" Padding="0,3" Style="{StaticResource Quiet}" Click="CloseClick" /></StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="207" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Margin="14,15,8,20">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="PLAY YOUR WAY" Style="{StaticResource Caption}" Margin="16,0,0,18" FontSize="10" />
            <Button x:Name="HomeNav" Click="NavigationClick" Tag="home" HorizontalContentAlignment="Left" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="27" FontSize="18" Foreground="#B9A5F5" /><TextBlock Text="{DynamicResource Text.home}" VerticalAlignment="Center" /></StackPanel></Button>
