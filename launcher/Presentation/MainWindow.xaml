<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ToolLauncher.Presentation.MainWindow" Title="ToolLauncher" Icon="/ToolLauncher;component/Assets/ToolVisuals.ico" Width="1280" Height="850" MinWidth="1100" MinHeight="740" Background="#101118" Foreground="#ECECF4" FontFamily="Segoe UI" FontSize="16" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
