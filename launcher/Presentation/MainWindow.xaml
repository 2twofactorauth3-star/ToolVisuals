                          <Ellipse Canvas.Left="324" Canvas.Top="109" Width="4" Height="4" Fill="#C2A9FF" />
                          <Ellipse Canvas.Left="245" Canvas.Top="9" Width="3" Height="3" Fill="#A9CFCF" />
