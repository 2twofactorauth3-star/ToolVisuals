<UserControl x:Class="ToolLauncher.Presentation.Accounts.AccountImportPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#B5101118" Focusable="True" KeyboardNavigation.TabNavigation="Cycle" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed" UseLayoutRounding="True">
  <Border MaxWidth="850" MaxHeight="690" Margin="30" Padding="28" Background="#191923" BorderBrush="#494056" BorderThickness="1" CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Source="{StaticResource BrandLogo}" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12" /></Image.Clip></Image>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Text.importTitle}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Text.importSubtitle}" FontSize="14" Foreground="#AFA5C3" Margin="0,4,0,0" /></StackPanel>
        <Button Grid.Column="3" Content="EN / RU" Click="LanguageClick" Style="{StaticResource Quiet}" FontSize="14" VerticalAlignment="Top" Padding="9,8" />
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,18,0,14">
        <TextBlock x:Name="DiscoveryStatus" Foreground="#C9C2D5" FontSize="15" TextWrapping="Wrap" />
        <ProgressBar x:Name="ScanProgress" Height="3" IsIndeterminate="True" Foreground="#B9A0F5" Background="#30283E" Margin="0,12,0,0" />
      </StackPanel>
      <Grid Grid.Row="2" MinHeight="110">
        <ListBox x:Name="AccountsList" ItemContainerStyle="{StaticResource ListItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#23212F" CornerRadius="10" Padding="13,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" FontSize="16" Margin="0" VerticalAlignment="Center"><CheckBox.Content><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Source}" FontSize="13" Foreground="#ABA2BA" Margin="0,4,0,0" /></StackPanel></CheckBox.Content><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="19" Height="19" CornerRadius="5" BorderBrush="#88729F" BorderThickness="1" VerticalAlignment="Center"><Path x:Name="Mark" Data="M 0,4 L 3,7 L 9,0" Stroke="#C6AAF8" StrokeThickness="2" Width="11" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" /></Border><ContentPresenter Grid.Column="1" Margin="11,0,0,0" /></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox>
                  <Border Grid.Column="1" Background="#363043" CornerRadius="6" Padding="9,5" Margin="15,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="13" Foreground="#D2C3EA"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{DynamicResource Text.accountLocal}" /><Style.Triggers><DataTrigger Binding="{Binding Microsoft}" Value="True"><Setter Property="Text" Value="Microsoft" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyHint" Text="{DynamicResource Text.importEmpty}" FontSize="16" Foreground="#AFA5C3" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="480" Visibility="Collapsed" />
      </Grid>
      <StackPanel Grid.Row="3" Margin="0,14,0,18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Text.startingAccount}" FontSize="15" VerticalAlignment="Center" /><ComboBox x:Name="DefaultAccount" Grid.Column="2" DisplayMemberPath="Label" MinHeight="43" /></Grid>
        <TextBlock Text="{DynamicResource Text.importDisclosure}" FontSize="14" Foreground="#ADA2BB" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0" />
        <TextBlock x:Name="ImportError" TextWrapping="Wrap" FontSize="14" Foreground="#F1B2C1" Margin="0,7,0,0" Visibility="Collapsed" />
      </StackPanel>
      <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{DynamicResource Text.importFolder}" Click="FolderClick" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Padding="0,12" /><Button x:Name="SkipButton" Grid.Column="1" Content="{DynamicResource Text.importSkip}" Click="SkipClick" Style="{StaticResource Quiet}" /><Button x:Name="ImportButton" Grid.Column="3" Content="{DynamicResource Text.importAccounts}" Click="ImportClick" Style="{StaticResource Primary}" IsEnabled="False" /></Grid>
    </Grid>
  </Border>
</UserControl>
