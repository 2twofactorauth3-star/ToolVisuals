<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:operations="clr-namespace:ToolLauncher.Presentation.Operations" x:Class="ToolLauncher.App">
  <Application.Resources>
    <BitmapImage x:Key="BrandLogo" UriSource="/ToolLauncher;component/Assets/ToolVisuals.jpg" CacheOption="OnLoad" />
    <BitmapImage x:Key="Landscape" UriSource="/ToolLauncher;component/Assets/Valley-dusk.png" CacheOption="OnLoad" DecodePixelWidth="1672" />
    <SolidColorBrush x:Key="Surface" Color="#101318" />
    <SolidColorBrush x:Key="Card" Color="#1B1E24" />
    <SolidColorBrush x:Key="Line" Color="#343840" />
    <SolidColorBrush x:Key="Muted" Color="#B4B5BF" />
    <SolidColorBrush x:Key="Accent" Color="#9561FF" />
    <SolidColorBrush x:Key="SelectedForeground" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="PrimaryActionBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#945CFF" Offset="0" /><GradientStop Color="#7A42ED" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="InputFill" Color="#1B1F26" />
    <SolidColorBrush x:Key="InputLine" Color="#444953" />
    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1E222A" Offset="0" /><GradientStop Color="#181C22" Offset="1" /></LinearGradientBrush>
    <Style TargetType="TextBlock">
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#242837" />
      <Setter Property="Foreground" Value="#F1F0EC" />
      <Setter Property="BorderBrush" Value="#383D50" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="operations:HoverFeedback.Track" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#E4E4F0" />
      <Setter Property="Background" Value="#20232B" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="17,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" />
              <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" CornerRadius="10" IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.055" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="BorderBrush" Value="#BAA2ED" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#8C829E" />
                <Setter Property="Background" Value="#2B2638" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PrimaryActionBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B3AEC2" />
    </Style>
    <Style x:Key="QuickAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource CardFill}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Padding" Value="24,16" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Height" Value="68" />
    </Style>
    <Style x:Key="ModMutationAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="IsEnabled" Value="{DynamicResource CanModifyMods}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Id}" Value="toolvisuals">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#181C22" />
      <Setter Property="Foreground" Value="#F2F0FA" />
      <Setter Property="CaretBrush" Value="#9561FF" />
      <Setter Property="BorderBrush" Value="#444953" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="SelectionBrush" Value="#634198" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#181C22" />
      <Setter Property="Foreground" Value="#F2F0FA" />
      <Setter Property="BorderBrush" Value="#444953" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D9DAE7" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="0,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckBody" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="#45445A" Background="#232635" VerticalAlignment="Center">
                <TextBlock x:Name="CheckMark" Text="✓" Foreground="#181222" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              </Border>
              <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBody" Property="Background" Value="#9561FF" />
                <Setter TargetName="CheckBody" Property="BorderBrush" Value="#9561FF" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBody" Property="Opacity" Value="0.75" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="#E4E1F1" />
      <Setter Property="Background" Value="#1B1F26" />
      <Setter Property="BorderBrush" Value="#444953" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="#DAD6E7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter Property="Background" Value="#302840" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Foreground" Value="#D3BFFF" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="PickerToggle" Focusable="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                      <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#B4A8CC" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="12,0,30,0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="{DynamicResource PopupMotion}">
                <Border Background="#1B1F26" CornerRadius="10" BorderBrush="#454952" BorderThickness="1" Padding="4" MinWidth="{TemplateBinding ActualWidth}" Margin="0,5,0,0">
                  <ScrollViewer MaxHeight="280">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PickerToggle" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="PickerToggle" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style x:Key="TrackThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#514D65" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Body" CornerRadius="6" Background="{TemplateBinding Background}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#9561FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource TrackThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderRail" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="#343044" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="24" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRail}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16" MinHeight="0" Margin="0" Background="#9561FF" Style="{StaticResource TrackThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRail}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#F1F0EC" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="23" />
      <Setter Property="Margin" Value="0,7,0,14" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <LinearGradientBrush x:Key="NavSelected" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#302641" Offset="0" /><GradientStop Color="#252239" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="Sidebar" Color="#101318" />
    <Style x:Key="LineIcon" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style x:Key="NavIcon" TargetType="Path" BasedOn="{StaticResource LineIcon}">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="Margin" Value="0,0,11,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Navigation" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Sidebar}" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Padding" Value="{DynamicResource NavigationPadding}" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" />
          <Border x:Name="Hover" Background="#FFFFFF" Opacity="0" CornerRadius="10" IsHitTestVisible="False" />
          <Border Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="0,10" Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.055" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.1" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LaunchAction" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="{StaticResource PrimaryActionBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="Height" Value="54" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Resources>
</Application>
