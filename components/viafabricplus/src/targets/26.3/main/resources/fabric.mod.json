{
  "schemaVersion": 1,
  "id": "viafabricplus",
  "version": "5.1.1",
  "name": "ViaFabricPlus",
  "description": "Minecraft Fabric mod that allows you to join EVERY Minecraft server version (Classic, Alpha, Beta, Release, April Fools)",
  "authors": [
